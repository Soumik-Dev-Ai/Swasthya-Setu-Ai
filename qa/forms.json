{
  "register_asha": {
    "route": "/#/app/asha/register",
    "fields": [
      {"label": "asha_worker|username|उपयोगकर्ता", "value": "{{asha_user}}"},
      {"label": "••••|password|पासवर्ड", "value": "{{asha_pass}}"},
      {"label": "Sunita|name|नाम", "value": "QA Asha"},
      {"label": "98765|phone|फ़ोन", "value": "9876543210"},
      {"label": "7890|aadhaar|आधार", "value": "1234"},
      {"label": "Khoribari|village|गाँव", "value": "QA Village"},
      {"label": "Jaipur|district|ज़िला", "value": "QA District"}
    ],
    "submit": "submit|register|sign up|पंजीकरण"
  },
  "create_patient": {
    "route": "/#/app/asha/portal",
    "fields": [
      {"label": "patient name|display|नाम", "value": "{{mark}}"},
      {"label": "98765|phone|फ़ोन", "value": "9{{run}}"},
      {"label": "birth|dob|1990", "value": "1990-01-01"}
    ],
    "submit": "register patient|create|save|add"
  },
  "create_referral": {
    "route": "/#/app/asha/portal?tab=referrals",
    "fields": [
      {"label": "patient|uuid", "value": "11111111-1111-1111-1111-111111111111"},
      {"label": "from facility", "value": "1"},
      {"label": "to facility", "value": "2"},
      {"label": "urgency", "value": "L3", "kind": "select"}
    ],
    "submit": "Create \\(idempotent\\)|create|refer"
  }
}
