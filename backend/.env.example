# ── SwasthyaSetu AI backend environment template ────────────────────────────
# Copy to .env and fill in. NEVER commit real .env values.

# Runtime mode: dev | prod | test. When "prod", the app refuses to start
# with any of the insecure defaults below still in place.
ENV=dev

# doc 24: where this process runs. cloud_production (default, safe) forbids
# the fine-tuned edge model from loading in the backend; local_dev enables it
# for local testing only. The cloud backend's only refinement path is the
# online Reasoning Engine cascade.
DEPLOYMENT_TARGET=cloud_production

# Database: SQLite for local dev; Postgres (Neon free tier) in production.
DATABASE_URL=sqlite+aiosqlite:///./swasthyasetu.db
# DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname

# Auth. Both secrets MUST be long random strings in production, and the
# refresh secret must differ from the access secret.
JWT_SECRET=changeme-long-random-string
JWT_REFRESH_SECRET=changeme-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed-only default credentials (never keep these values in prod).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ASHA_USERNAME=asha1
DEFAULT_ASHA_PASSWORD=asha123

# CORS — explicit allow-list, JSON array. Add the deployed frontend origin.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional LLM cascade keys (all optional; missing keys degrade gracefully).
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Cost-engine scrape fallback. Keep "false" unless deliberately enabling
# the community-estimate path (AI Ethics Rule 4 — no fabricated pricing).
ENABLE_WEB_SCRAPE=false

# Tuning
CACHE_TTL_SECONDS=86400
ADVANCED_SEARCH_RATE_LIMIT=10/minute
PUBLIC_HEAVY_RATE_LIMIT=30/minute
VISION_MAX_IMAGE_BYTES=8388608

# ── Knowledge Engine (Phase 3) ──────────────────────────────────────────────
# Embedding profile: "hash" = deterministic offline default (CI/dev);
# "intfloat/multilingual-e5-small" = real multilingual semantic retrieval
# (requires: pip install sentence-transformers; ~470MB model on first load).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Corpus roots (relative to backend/, so ../docs_raw from here).
RAG_CORPUS_DIR=../docs_raw
FINANCIAL_CORPUS_DIR=../docs_raw/financial
# Retrieval + grounding thresholds (hash score floor / semantic dense floor /
# citation overlap floor).
RAG_TOP_K=4
RAG_MIN_SCORE=0.09
RAG_MIN_DENSE=0.85
GROUNDING_MIN_OVERLAP=0.15

# Frontend (frontend/.env.local) must point at this API:
# VITE_API_BASE_URL=http://localhost:8000/api
